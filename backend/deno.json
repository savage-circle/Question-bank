{
  "name": "question-bank-backend",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window"],
    "types": ["node"]
  },
  "tasks": {
    "start": "deno run -A --env-file=.env main.ts",
    "test": "deno test -P --env-file=.env",
    "db:generate": "deno run -A npm:prisma generate",
    "db:migrate": "deno run -A npm:prisma migrate dev",
    "db:apply": "deno run -A npm:prisma migrate deploy"
  },
  "test": {
    "include": ["tests/**/*.ts"],
    "permissions": {
      "read": true,
      "net": ["localhost", "localhost:5432"],
      "env": true
    }
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.12.23",
    "@hono/logger": "jsr:@hono/hono/logger",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing/bdd",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.0.0",
    "@prisma/client": "npm:@prisma/client@^7.0.0",
    "prisma": "npm:prisma@^7.0.0",
    "pg": "npm:pg@^8.11.0"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "no-unused-vars",
        "no-debugger",
        "no-constant-condition",
        "no-empty-interface",
        "no-var",
        "ban-untagged-ignore"
      ],
      "exclude": []
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "exclude": ["*.md", "**/*.md"]
  }
}
