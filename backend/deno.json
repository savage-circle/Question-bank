{
  "name": "question-bank-backend",
  "version": "0.1.0",
  "tasks": {
    "start": "deno run -A main.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.12.23",
    "@hono/logger": "jsr:@hono/hono/logger",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing/bdd"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "no-unused-vars",
        "no-debugger",
        "no-constant-condition",
        "no-empty-interface",
        "no-var",
        "ban-untagged-ignore"
      ],
      "exclude": []
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "semiColons": true,
    "exclude": ["*.md", "**/*.md"]
  }
}
